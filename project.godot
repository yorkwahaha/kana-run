; Kana Run — 五十音疾走
; Godot 4.7 project configuration

config_version=5

[application]

config/name="Kana Run 五十音疾走"
config/description="五十音記憶跑酷 — 一款以適性化間隔重複為核心的日文閱讀跑酷遊戲"
config/version="1.0.0"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/show_image=false
config/icon="res://icon.svg"
config/quit_on_go_back=false

[autoload]

InputKit="*res://src/core/input_kit.gd"
FontKit="*res://src/core/font_kit.gd"
SaveGame="*res://src/core/save_game.gd"
SceneKit="*res://src/core/scene_kit.gd"
Sfx="*res://src/core/sfx.gd"
Srs="*res://src/core/srs.gd"
Curriculum="*res://src/core/curriculum.gd"

[audio]

; Web 的生效鍵是 default_playback_type.web，不是不帶後綴的那一項。
; 引擎內建 .web=1（Sample）。只寫 default_playback_type="Stream"
; 在網頁版完全不會被讀到，播放模式仍是 Sample。
;
; Sample 再碰到執行期 AudioServer.add_bus()（本專案有 Music / Sfx 兩條）
; 會踩 Godot #119026：JS 端 Master 的輸出被從 AudioContext.destination 拔掉。
; 播放器回報 playing、bus 沒靜音、沒有 AudioContext 警告，喇叭卻是全靜音。
; 桌機沒有這條 JS bus，所以只有網頁版中招。
;
; 0 = Stream，1 = Sample。這兩個數字不是 AudioServer.PlaybackType 的列舉值。
; 單執行緒網頁版用 Stream 延遲較高，但混音走 Godot 自己的驅動，不經過壞掉的圖。
driver/enable_input=false
general/default_playback_type=0
general/default_playback_type.web=0

[debug]

gdscript/warnings/untyped_declaration=0
gdscript/warnings/unsafe_property_access=0
gdscript/warnings/unsafe_method_access=0
gdscript/warnings/inference_on_variant=1
gdscript/warnings/native_method_override=1

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0
window/vsync/vsync_mode=1

[editor_plugins]

enabled=PackedStringArray()

[filesystem]

import/blender/enabled=false

[gui]

theme/default_font_antialiasing=1
theme/default_font_hinting=2
theme/default_font_subpixel_positioning=1

[input_devices]

pointing/emulate_mouse_from_touch=true

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_render/layer_1="default"

[physics]

3d/default_gravity=24.0

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/default_filters/anisotropic_filtering_level=4
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/directional_shadow/size=4096
environment/defaults/default_clear_color=Color(0.043, 0.031, 0.078, 1)
environment/defaults/default_environment=""
occlusion_culling/use_occlusion_culling=false
viewport/hdr_2d=true
