; Kana Run — 五十音疾走
; Godot 4.7 project configuration

config_version=5

[application]

config/name="Kana Run 五十音疾走"
config/description="五十音記憶跑酷 — 一款以適性化間隔重複為核心的日文閱讀跑酷遊戲"
config/version="1.0.0"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/show_image=false
config/icon="res://icon.svg"
config/quit_on_go_back=false

[autoload]

InputKit="*res://src/core/input_kit.gd"
FontKit="*res://src/core/font_kit.gd"
SaveGame="*res://src/core/save_game.gd"
SceneKit="*res://src/core/scene_kit.gd"
Sfx="*res://src/core/sfx.gd"
Srs="*res://src/core/srs.gd"
Curriculum="*res://src/core/curriculum.gd"

[audio]

; Godot 4.3+ 在 web 預設用 Sample 播放模式，但 Sample 模式在 web 上有已知問題：
; AudioContext 沒有被正確 resume，整個遊戲會完全靜默（連程序化音效都沒有）。
; Godot 官方文件明確建議改用 Stream 模式取得完整的音訊功能。
; 代價是延遲較高（尤其關閉 thread 時），對這個遊戲可以接受。
driver/enable_input=false
general/default_playback_type="Stream"

[debug]

gdscript/warnings/untyped_declaration=0
gdscript/warnings/unsafe_property_access=0
gdscript/warnings/unsafe_method_access=0
gdscript/warnings/inference_on_variant=1
gdscript/warnings/native_method_override=1

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0
window/vsync/vsync_mode=1

[editor_plugins]

enabled=PackedStringArray()

[filesystem]

import/blender/enabled=false

[gui]

theme/default_font_antialiasing=1
theme/default_font_hinting=2
theme/default_font_subpixel_positioning=1

[input_devices]

pointing/emulate_mouse_from_touch=true

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_render/layer_1="default"

[physics]

3d/default_gravity=24.0

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/default_filters/anisotropic_filtering_level=4
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/directional_shadow/size=4096
environment/defaults/default_clear_color=Color(0.043, 0.031, 0.078, 1)
environment/defaults/default_environment=""
occlusion_culling/use_occlusion_culling=false
viewport/hdr_2d=true
